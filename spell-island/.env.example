# ===== 豆包（火山引擎）语音：识别 + 合成，用同一个 API Key =====
# 控制台：火山引擎 → 豆包语音 → API Key（新版鉴权，X-Api-Key）
DOUBAO_SPEECH_API_KEY=your-doubao-speech-api-key
# 流式语音识别（Seed ASR 2.0，小时版）。如开通的是并发版，改成 volc.seedasr.sauc.concurrent
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# 语音合成 2.0
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0

# ===== 大模型（可选）：不填就用本地规则大脑，四关照样能玩 =====
# auto | deepseek | doubao | none
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 豆包大模型（方舟）：填 API Key 和模型/接入点 ID，例如 doubao-seed-1-6-flash-250828
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-1-lite-260915
# hybrid：规则先判断（最快），听不懂的话再交给大模型；llm：每句都走大模型；rules：只用规则
BRAIN_MODE=hybrid
LLM_TIMEOUT_MS=2500

PORT=8787
