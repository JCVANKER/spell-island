{
  "name": "@spell/desktop",
  "version": "1.3.1",
  "private": true,
  "description": "Mac \u684c\u9762\u7248\uff08Electron \u5916\u58f3\uff0c\u5185\u7f6e\u540e\u7aef\u4e0e\u8c46\u5305\u8bed\u97f3\uff09",
  "scripts": {
    "pack": "node build.mjs"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "com.ncjng.spellisland",
    "productName": "\u5492\u8bed\u5c9b",
    "electronVersion": "33.4.11",
    "directories": {
      "app": "app",
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "\u5492\u8bed\u5c9b\u9700\u8981\u542c\u5b69\u5b50\u7528\u82f1\u8bed\u5ff5\u5492\u8bed\u3001\u6307\u6325\u5c0f\u9b54\u6cd5\u5e08\u3002",
        "LSApplicationCategoryType": "public.app-category.education",
        "NSHighResolutionCapable": true
      }
    }
  }
}
